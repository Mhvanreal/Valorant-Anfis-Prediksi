APP_NAME=ValorantAnfis
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# -------------------------------------------------------
# Python Path — digunakan oleh SkinScraperController
# Contoh Linux/server : /usr/bin/python3
# Contoh Windows      : D:\laragon\bin\python\python-3.13\python.exe
# -------------------------------------------------------
PYTHON_PATH=/usr/bin/python3

# -------------------------------------------------------
# FastAPI URL — endpoint ANFIS recommendation service
# Development  : http://127.0.0.1:8000
# Docker       : http://fastapi:8000  (nama service di docker-compose)
# Production   : http://15.235.182.106:40454
# -------------------------------------------------------
FASTAPI_URL=http://15.235.182.106:40454

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=valorant_anfis
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_NAME=ValorantAnfis
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# -------------------------------------------------------
# Python Path — digunakan oleh SkinScraperController
# Sesuaikan dengan lokasi Python di server/lokal Anda
# Contoh Linux/server : /usr/bin/python3
# Contoh Windows      : D:\laragon\bin\python\python-3.13\python.exe
# -------------------------------------------------------
PYTHON_PATH=/usr/bin/python3

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=valorant_anfis
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
